# Database (shared across all apps)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/flowys?retryWrites=true&w=majority

# Authentication
AUTH_SECRET=your-auth-secret-generate-with-openssl-rand-base64-32

# Fixed login account (configured in code)
# Email: user@flowys.io
# Password: @FLOWYS2025

# Cross-domain URLs (Production)
NEXT_PUBLIC_APP_URL=https://app.flowys.io
NEXT_PUBLIC_LANDING_URL=https://flowys.io

# Cross-domain URLs (Development) - uncomment for local development
# NEXT_PUBLIC_APP_URL_DEV=http://localhost:3001
# NEXT_PUBLIC_LANDING_URL_DEV=http://localhost:3000

# Encryption key for storing integration credentials (must be 32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key

# AI Providers
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Integration OAuth (Google Sheets, etc.)
# These are used for workflow integrations
# GOOGLE_SHEETS_CLIENT_ID=your-sheets-client-id
# GOOGLE_SHEETS_CLIENT_SECRET=your-sheets-client-secret

# Optional: Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
